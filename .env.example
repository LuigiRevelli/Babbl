# Babbl — variables d'environnement. Copier en `.env` à la racine pour le
# développement ; en production, les saisir dans l'hébergeur. Ne jamais committer `.env`.

# ─── Backend ───────────────────────────────────────────────────────────
# Rédaction du résumé (Claude Sonnet 5). Sans clé : résumé en texte fixe, tout le reste marche.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# Voix : résumé lu et voix clonée du parent. Sans clé : pas d'audio, tout le reste marche.
ELEVENLABS_API_KEY=
# Base de données (clé « service role », côté serveur uniquement). Sans elles :
# analyses non enregistrées, « ce qui a apaisé » gardé dans le téléphone, pas d'effacement de compte.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Production : origines autorisées à appeler l'API, séparées par des virgules.
# BABBL_ALLOWED_ORIGINS=https://babbl.fr,https://www.babbl.fr
# Processus gunicorn (1 sur une instance de 512 Mo).
# WEB_CONCURRENCY=1
# Limites anti-abus (appels payants).
# BABBL_ANALYZE_PER_10MIN=20
# BABBL_CLONE_PER_DAY=3

# ─── Frontend (préfixe VITE_, valeurs publiques) ───────────────────────
VITE_API_URL=http://localhost:5001
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Cartes v2 (brouillons de draft_cards.py). NE PAS activer avant relecture
# pédiatrique : absent ou 0 = cartes v1 actuelles.
# BABBL_CARDS_V2=1

# Durée de conservation des analyses et du journal, en jours (purge.py, à lancer
# chaque jour). Absent = aucune purge. À fixer avec l'avocat. Minimum 30.
# BABBL_RETENTION_DAYS=730
